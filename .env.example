# mcp-unifi: environment configuration
# Copy this file to `.env` and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Mode toggle
# ---------------------------------------------------------------------------
# STUB_MODE=true  → returns realistic mock data, no network calls.
#                   Use this until the gateway is on the network, or for
#                   demos / development.
# STUB_MODE=false → talks to a real UniFi gateway over HTTPS. Requires
#                   UNIFI_HOST and UNIFI_API_KEY.
STUB_MODE=true

# ---------------------------------------------------------------------------
# Gateway connection (only required when STUB_MODE=false)
# ---------------------------------------------------------------------------
UNIFI_HOST=192.168.1.1
UNIFI_PORT=443
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# Generated under Settings → Control Plane → Integrations on the gateway.
# Sent as the X-API-Key header on every request.
UNIFI_API_KEY=

# ---------------------------------------------------------------------------
# IoT defaults (used by create_iot_network)
# ---------------------------------------------------------------------------
# Subnet template: {vlan_id} gets substituted at call time.
IOT_SUBNET_TEMPLATE=10.0.{vlan_id}.0/24
IOT_DHCP_START_OFFSET=100
IOT_DHCP_STOP_OFFSET=200

# ---------------------------------------------------------------------------
# MCP server settings
# ---------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=3714

# Logging: structured JSON (production) or human-readable text (local dev).
LOG_LEVEL=INFO
LOG_FORMAT=json

TZ=UTC

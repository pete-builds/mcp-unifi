# mcp-unifi: environment configuration
# Copy this file to `.env` and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Mode toggle
# ---------------------------------------------------------------------------
# STUB_MODE=true  → returns realistic mock data, no network calls.
#                   Use this until the gateway is on the network, or for
#                   demos / development.
# STUB_MODE=false → talks to a real UniFi gateway over HTTPS. Requires
#                   UNIFI_HOST and UNIFI_API_KEY.
STUB_MODE=true

# ---------------------------------------------------------------------------
# Gateway connection (only required when STUB_MODE=false)
# ---------------------------------------------------------------------------
UNIFI_HOST=192.168.1.1
UNIFI_PORT=443
UNIFI_SITE=default
# Leave unset for the default: off for an inline key (self-signed console), on
# for a file-backed key or a pinned certificate. Setting it to false alongside
# UNIFI_PINNED_CERT is rejected at startup as a contradiction.
# UNIFI_VERIFY_SSL=false

# Generated under Settings → Control Plane → Integrations on the gateway.
# Sent as the X-API-Key header on every request.
UNIFI_API_KEY=
# Or read it from a file (Docker/Kubernetes secret mount). Wins over
# UNIFI_API_KEY when both are set, and turns UNIFI_VERIFY_SSL on by default.
# UNIFI_API_KEY_FILE=/run/secrets/unifi_api_key

# Which API surface the legacy single-controller settings use. Both default as
# shown, so leave these commented unless you need the other value.
#   UNIFI_PROTECT_API: internal | integration (integration: UniFi OS 5.x keys,
#                      events and recordings unavailable there)
#   UNIFI_WRITE_API:   auto | private (private keeps every write on the private API)
# UNIFI_PROTECT_API=internal
# UNIFI_WRITE_API=auto

# Pin the console's own certificate so the server accepts that one and nothing
# else. Record it once with: mcp-unifi-pin-cert $UNIFI_HOST --out ./pins/home.pem
# Turns UNIFI_VERIFY_SSL on; a mismatch fails closed. Re-run with --force if a
# firmware update regenerates the certificate.
# In a container this is a path INSIDE the container: mount the pin file and
# point at the mount (for example /pins/home.pem).
# UNIFI_PINNED_CERT=./pins/home.pem

# ---------------------------------------------------------------------------
# UniFi Access (v0.10+, only required when the access module is enabled and
# you want real-mode reads against a live Access hub). Stub mode requires no
# values. Access uses a SEPARATE API key from the Network key; generate it
# under the Access controller's developer settings, not on the gateway.
# ---------------------------------------------------------------------------
UNIFI_ACCESS_HOST=192.168.1.20
UNIFI_ACCESS_PORT=12445
UNIFI_ACCESS_API_KEY=
# Or read the Access key from a file. Wins over UNIFI_ACCESS_API_KEY.
# UNIFI_ACCESS_API_KEY_FILE=/run/secrets/unifi_access_api_key

# ---------------------------------------------------------------------------
# Modules and multi-site
# ---------------------------------------------------------------------------
# MCP_UNIFI_MODULES_ENABLED and the MCP_UNIFI_AUDIT_* variables below are read
# from the process environment only. A .env file does NOT set them: export them
# in your shell, service unit, `docker run -e`, or the compose environment block.
#
# Modules to load. Default is network only; protect and access are opt-in.
# MCP_UNIFI_MODULES_ENABLED=network,protect,access
#
# YAML file of named controllers for multi-site. When set, the UNIFI_* gateway
# settings above are ignored.
# MCP_UNIFI_CONTROLLERS_FILE=./controllers.yaml
# Which controller a call targets when it omits `controller` and several are
# configured. Must name a controller in the file.
# MCP_UNIFI_DEFAULT_CONTROLLER=home

# ---------------------------------------------------------------------------
# Audit log (read from the process environment only, see above)
# ---------------------------------------------------------------------------
# One of: file (default), stdout, syslog. Do not use stdout with the stdio
# transport: both write to stdout.
# MCP_UNIFI_AUDIT_SINK=file
# File path when the sink is file. Default: ./audit.jsonl
# MCP_UNIFI_AUDIT_PATH=./audit.jsonl
# Socket path or host:port when the sink is syslog. Default: /dev/log
# MCP_UNIFI_AUDIT_SYSLOG_ADDRESS=/dev/log

# ---------------------------------------------------------------------------
# IoT defaults (used by create_iot_network)
# ---------------------------------------------------------------------------
# Subnet template: {vlan_id} gets substituted at call time.
IOT_SUBNET_TEMPLATE=10.0.{vlan_id}.0/24
IOT_DHCP_START_OFFSET=100
IOT_DHCP_STOP_OFFSET=200

# ---------------------------------------------------------------------------
# MCP server settings
# ---------------------------------------------------------------------------
# Transport. 'streamable-http' (default) for the long-running container.
# 'stdio' for Claude Desktop / per-session subprocess installs (uvx, pipx).
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=3714

# Logging: structured JSON (production) or human-readable text (local dev).
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# HTTP transport authentication (v0.9.0+)
# ---------------------------------------------------------------------------
# Bearer tokens for clients connecting over streamable-http. Comma-separated.
# Each entry is either a bare token (auto-assigned client_id 'client-0',
# 'client-1', ...) or a 'name:token' pair for named clients. The 'name'
# shows up in the audit log so you can trace each call back to its caller.
#
# Generate a token:
#   openssl rand -hex 32
#
# Example:
#   MCP_UNIFI_AUTH_TOKENS=claude:7f3a...,n8n:c812...,homeassistant:a4d9...
# Or read the token from a file. The file holds one bare token, named by
# MCP_UNIFI_CLIENT_ID, or the full MCP_UNIFI_AUTH_TOKENS grammar. Adds to
# whatever MCP_UNIFI_AUTH_TOKENS defines.
# MCP_UNIFI_AUTH_TOKEN_FILE=/run/secrets/mcp_unifi_token
# MCP_UNIFI_CLIENT_ID=admin
#
# Clients send: Authorization: Bearer <token>
#
# Ignored on stdio transport (parent process owns the security boundary).
MCP_UNIFI_AUTH_TOKENS=

# Secure-by-default. If True (default), the server refuses to start on HTTP
# transport without tokens configured above. Set to false ONLY if the server
# is on a single-host trusted boundary (e.g. localhost-only with a private
# network namespace). Even then, prefer setting at least one token.
MCP_UNIFI_AUTH_REQUIRED=true

# ---------------------------------------------------------------------------
# Read-only mode
# ---------------------------------------------------------------------------
# When true, every tool that changes state is hidden from tools/list AND
# refused on tools/call; read tools are unaffected. Defense in depth on top of
# a read-only UniFi API key: the key decides what the controller accepts, this
# decides what the server is willing to attempt. Default false so existing
# deployments keep their current behavior.
MCP_UNIFI_READONLY=false

# ---------------------------------------------------------------------------
# Response shape
# ---------------------------------------------------------------------------
# By default every tool result carries the full JSON in the text block, and
# clients on MCP 2025-06-18 or later also get it parsed as structuredContent.
#
# Set this to true ONLY if your host feeds structuredContent to the model. The
# text block then shrinks to a one-line summary ("list_devices returned 10
# record(s). Full result is in structuredContent.") and the data travels in
# structuredContent alone, which saves tokens. On a host that shows the model
# only the text block (Claude Desktop, most stdio bridges and proxies) that
# summary is all the model would see, so leave it false there.
MCP_UNIFI_COMPACT_RESPONSES=false

TZ=UTC

# ---------------------------------------------------------------------------
# UniFi OS console credentials (OPTIONAL, v0.18.0+)
# ---------------------------------------------------------------------------
# The Network API key above authenticates the Network application *through*
# the UniFi OS proxy. It does NOT authenticate UniFi OS's own /api/* endpoints
# (verified live: those answer 401 with a valid Network key).
#
# Set these to unlock console-session tools (get_console_firmware). Leaving
# them unset is fully supported: get_console_health and get_console_info work
# without them, and session-gated tools return a clear "not configured"
# message rather than a bare 401.
#
# Use a dedicated local console admin, not your Ubiquiti SSO account.
# UNIFI_OS_USERNAME=
# UNIFI_OS_PASSWORD=
# Or read the password from a file (Docker/Kubernetes secret mount). Wins over
# UNIFI_OS_PASSWORD.
# UNIFI_OS_PASSWORD_FILE=/run/secrets/unifi_os_password
